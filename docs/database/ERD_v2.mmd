erDiagram
    SOURCE_CATALOG ||--o{ PIPELINE_ARTIFACT : "has output"
    EXTRACTION_BATCH ||--o{ PIPELINE_ARTIFACT : "creates"
    PIPELINE_ARTIFACT ||--o{ PIPELINE_ARTIFACT : "derived from"
    SOURCE_CATALOG ||--o{ SOURCE_OBSERVATION : "reported"
    PIPELINE_ARTIFACT ||--o{ SOURCE_OBSERVATION : "contains"
    LCI_EXCHANGE o|--o{ SOURCE_OBSERVATION : "normalized to"
    SOURCE_CATALOG ||--o{ SOURCE_EVIDENCE : "documented by"
    MAP_ASSET ||--o{ MAP_ASSET_SOURCE : "supported by"
    SOURCE_CATALOG ||--o{ MAP_ASSET_SOURCE : "cited for asset"
    SOURCE_EVIDENCE o|--o{ MAP_ASSET_SOURCE : "specific evidence"
    MAP_ROUTE ||--o{ MAP_ROUTE_SOURCE : "supported by"
    SOURCE_CATALOG ||--o{ MAP_ROUTE_SOURCE : "cited for route"
